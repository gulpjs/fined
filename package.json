{
  "name": "fined",
  "version": "2.0.0",
  "description": "Find a file given a declaration of locations.",
  "author": "Gulp Team <team@gulpjs.com> (https://gulpjs.com/)",
  "contributors": [
    "Takayuki Sato <sttk.xslet@gmail.com>",
    "Blaine Bublitz <blaine.bublitz@gmail.com>"
  ],
  "funding": "https://github.com/sponsors/gulpjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulpjs/fined.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22.15.0"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": "./index.js",
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "LICENSE"
  ],
  "scripts": {
    "format-check": "prettier . --check",
    "format-write": "prettier . --write",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=test/lcov.info \"test/*.js\"",
    "types-check": "tsc index.js --checkJs --noEmit --types ./node.d.ts",
    "types-write": "tsc index.js --checkJs --declaration --declarationMap --emitDeclarationOnly --types ./node.d.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-gulp": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "keywords": [
    "find",
    "lookup",
    "config"
  ]
}
